/* LiveSubs style sheet template: {{token}} is replaced from the theme's token file.
   Fonts and colors that QSS does not reach come from the palette (see theme/__init__.py).
   Shape: cards 12 px, fields and buttons 8 px, Start/Stop a pill. No glow, no gradients:
   cards stand apart from the window by color alone. */

QMainWindow, QDialog {
    background: {{window}};
}

QToolTip {
    background: {{surface}};
    color: {{text}};
    border: 1px solid {{separator}};
    border-radius: 6px;
    padding: 4px 6px;
}

QLabel[hint="true"] {
    color: {{text_muted}};
}

QStatusBar {
    background: {{window}};
    color: {{text_muted}};
}

QStatusBar::item {
    border: none;
}

/* --- sidebar and page titles -------------------------------------------------------------- */

QWidget#sidebar {
    background: {{sidebar}};
    border-right: 1px solid {{separator}};
}

QLabel#logo {
    font-size: 17pt;
    font-weight: 700;
    color: {{text}};
    background: transparent;
}

QLabel#tagline {
    font-size: 9pt;
    color: {{text_muted}};
    background: transparent;
}

QListWidget#nav {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#nav::item {
    color: {{text}};
    padding: 0 10px;
    border-radius: 8px;
}

QListWidget#nav::item:hover:!selected {
    background: {{control_hover}};
}

QListWidget#nav::item:selected {
    background: {{accent}};
    color: {{accent_text}};
}

QLabel#pageTitle {
    font-size: 19pt;
    font-weight: 700;
    color: {{text}};
}

QScrollArea, QScrollArea > QWidget > QWidget#page {
    background: transparent;
}

/* --- cards -------------------------------------------------------------------------------- */

QGroupBox {
    background: {{surface}};
    border: 1px solid {{card_border}};
    border-radius: 12px;
    margin-top: 24px;
    padding: 8px 14px 12px 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 6px;
    top: 2px;
    color: {{text_muted}};
    font-weight: 600;
}

/* --- buttons ------------------------------------------------------------------------------ */

QPushButton {
    background: {{control}};
    color: {{text}};
    border: 1px solid {{control_border}};
    border-radius: 8px;
    padding: 6px 14px;
}

QPushButton:hover {
    background: {{control_hover}};
}

QPushButton:pressed {
    background: {{field_border}};
}

QPushButton:checked {
    background: {{accent}};
    border-color: {{accent}};
    color: {{accent_text}};
}

QPushButton:disabled {
    color: {{text_muted}};
    background: {{window}};
    border-color: {{separator}};
}

QPushButton[pill="true"] {
    border-radius: 20px;
    min-height: 38px;
    max-height: 38px;
    padding: 0 22px;
}

QPushButton#startButton {
    font-size: 13pt;
    font-weight: 600;
    color: {{accent_text}};
    background: {{accent}};
    border: none;
    border-radius: 22px;
    min-height: 44px;
    max-height: 44px;
    padding: 0 28px;
}

QPushButton#startButton:hover {
    background: {{accent_hover}};
}

QPushButton#startButton:pressed {
    background: {{accent_pressed}};
}

QPushButton#startButton[running="true"] {
    background: {{stop}};
}

QPushButton#startButton[running="true"]:hover {
    background: {{stop_hover}};
}

QPushButton#startButton[running="true"]:pressed {
    background: {{stop_pressed}};
}

/* --- inputs ------------------------------------------------------------------------------- */

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit, QKeySequenceEdit {
    background: {{field}};
    color: {{text}};
    border: 1px solid {{field_border}};
    border-radius: 8px;
    padding: 4px 8px;
    min-height: 20px;
    selection-background-color: {{selection}};
    selection-color: {{selection_text}};
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border-color: {{accent}};
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: {{text_muted}};
    background: {{window}};
    border-color: {{separator}};
}

QComboBox {
    padding-right: 26px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
}

QComboBox::down-arrow {
    image: url({{assets}}/arrow_down.svg);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background: {{surface}};
    color: {{text}};
    border: 1px solid {{separator}};
    padding: 4px;
    outline: none;
    selection-background-color: {{selection}};
    selection-color: {{selection_text}};
}

QAbstractSpinBox {
    padding-right: 22px;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    border: none;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 8px;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 8px;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background: {{control_hover}};
}

QAbstractSpinBox::up-arrow {
    image: url({{assets}}/arrow_up.svg);
    width: 10px;
    height: 10px;
}

QAbstractSpinBox::down-arrow {
    image: url({{assets}}/arrow_down.svg);
    width: 10px;
    height: 10px;
}

QCheckBox, QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background: {{field}};
    border: 1px solid {{field_border}};
}

QCheckBox::indicator {
    border-radius: 5px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:checked {
    background: {{accent}};
    border-color: {{accent}};
    image: url({{assets}}/check.svg);
}

QRadioButton::indicator:checked {
    background: {{knob}};
    border: 5px solid {{accent}};
    width: 8px;
    height: 8px;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background: {{window}};
    border-color: {{separator}};
}

/* --- tables and lists --------------------------------------------------------------------- */

QTableWidget, QTableView, QListView {
    background: {{surface}};
    alternate-background-color: {{window}};
    border: 1px solid {{separator}};
    border-radius: 8px;
    gridline-color: {{separator}};
    selection-background-color: {{selection}};
    selection-color: {{selection_text}};
    outline: none;
}

QTableView::item {
    padding: 3px 6px;
}

QHeaderView {
    background: transparent;
}

QHeaderView::section {
    background: {{surface}};
    color: {{text_muted}};
    font-weight: 600;
    border: none;
    border-bottom: 1px solid {{separator}};
    padding: 6px 8px;
}

QTableCornerButton::section {
    background: {{surface}};
    border: none;
}

QProgressBar {
    background: {{field}};
    border: 1px solid {{field_border}};
    border-radius: 8px;
    text-align: center;
    color: {{text}};
    min-height: 18px;
}

QProgressBar::chunk {
    border-radius: 7px;
    background: {{accent}};
}

QSlider::groove:horizontal {
    height: 4px;
    background: {{field_border}};
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: {{accent}};
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: {{knob}};
    border: 1px solid {{field_border}};
    width: 16px;
    margin: -7px 0;
    border-radius: 9px;
}

/* --- scroll bars and menus ---------------------------------------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle {
    background: {{scrollbar}};
    border-radius: 3px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:hover {
    background: {{text_muted}};
}

QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    width: 0;
    height: 0;
    background: none;
}

QMenu {
    background: {{surface}};
    color: {{text}};
    border: 1px solid {{separator}};
    padding: 4px;
}

QMenu::item {
    padding: 5px 18px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: {{accent}};
    color: {{accent_text}};
}

QMenu::separator {
    height: 1px;
    background: {{separator}};
    margin: 4px 8px;
}
